+/**
+ * Reads the commit a single platform ref points to. Fail-closed: only an exact,
+ * lightweight ref (object.type "commit") is accepted; annotated tags, redirects,
+ * non-200 responses or malformed bodies all throw.
+ */
+export function createPreviewRefCommitReader(runtimeFetch: (request: Request) => Promise<Response>) {
+  return async (refName: string, token: string): Promise<string> => {
+    const path = refName.replace(/^refs\//, "");
+    const response = await runtimeFetch(new Request(
+      `https://api.github.com/repos/${PREVIEW_WORKFLOW_REPOSITORY}/git/ref/${path}`,
+      {
+        method: "GET", redirect: "error", signal: AbortSignal.timeout(10000),
+        headers: { authorization: `Bearer ${token}`, accept: "application/vnd.github+json",
+          "x-github-api-version": "2022-11-28" },
+      },
+    ));
+    if (response.status !== 200) {
+      await response.body?.cancel();
+      throw new Error("PROJECT_PREVIEW_WORKFLOW_PIN_UNVERIFIABLE");
+    }
+    const body = await response.json() as { ref?: unknown; object?: { type?: unknown; sha?: unknown } };
+    if (body?.ref !== refName || body.object?.type !== "commit"
+      || typeof body.object.sha !== "string" || !/^[0-9a-f]{40}$/.test(body.object.sha)) {
+      throw new Error("PROJECT_PREVIEW_WORKFLOW_PIN_UNVERIFIABLE");
+    }
+    return body.object.sha;
+  };
+}
+
 export function createWebsiteProjectPreviewRuntimeDispatch(client: PreviewDispatchRpc) {
+  const runtimeFetch = (request: Request) => fetch(request);
   return createWebsiteProjectPreviewDispatch({
     client,
     workflowSha: Deno.env.get("LWS_PREVIEW_WORKFLOW_SHA") ?? "",
+    workflowRefName: Deno.env.get("LWS_PREVIEW_WORKFLOW_REF_NAME") ?? "",
     acquireToken: createPreviewPlatformTokenProvider(),
-    fetch: (request) => fetch(request),
+    readRefCommit: createPreviewRefCommitReader(runtimeFetch),
+    fetch: runtimeFetch,
   });
 }
