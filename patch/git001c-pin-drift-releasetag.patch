+import assert from "node:assert/strict";
+import { createPreviewRefCommitReader } from "./website-project-preview-dispatch-runtime.ts";
+import { assertRunnerRevision } from "../../../scripts/website-project-preview-complete.ts";
+
+const sha = "a".repeat(40);
+const tag = "refs/tags/lws-preview-runner-20261121-01";
+
+function reader(status: number, body: unknown, seen: Request[] = []) {
+  return createPreviewRefCommitReader(async (request) => {
+    seen.push(request);
+    return status === 200 ? Response.json(body) : new Response("private provider detail", { status });
+  });
+}
+
+Deno.test("ref reader asks GitHub for exactly the configured ref of the platform repository", async () => {
+  const seen: Request[] = [];
+  assert.equal(await reader(200, { ref: tag, object: { type: "commit", sha } }, seen)(tag, "test-token"), sha);
+  assert.equal(seen.length, 1);
+  assert.equal(seen[0].method, "GET");
+  assert.equal(seen[0].redirect, "error");
+  assert.equal(seen[0].url,
+    "https://api.github.com/repos/lorenzobombello-max/lorenzo-web-studio/git/ref/tags/lws-preview-runner-20261121-01");
+  assert.equal(seen[0].headers.get("authorization"), "Bearer test-token");
+  const main: Request[] = [];
+  await reader(200, { ref: "refs/heads/main", object: { type: "commit", sha } }, main)("refs/heads/main", "t");
+  assert.equal(main[0].url, "https://api.github.com/repos/lorenzobombello-max/lorenzo-web-studio/git/ref/heads/main");
+});
+
+Deno.test("ref reader fails closed on annotated tags, other refs, bad bodies and non-200", async () => {
+  for (const [status, body] of [
+    [200, { ref: tag, object: { type: "tag", sha } }],
+    [200, { ref: "refs/tags/lws-preview-runner-20261121-02", object: { type: "commit", sha } }],
+    [200, { ref: tag, object: { type: "commit", sha: "A".repeat(40) } }],
+    [200, { ref: tag }],
+    [200, [{ ref: tag, object: { type: "commit", sha } }]],
+    [404, null], [403, null], [301, null], [500, null],
+  ] as const) {
+    await assert.rejects(() => reader(status, body)(tag, "t"), /^Error: PROJECT_PREVIEW_WORKFLOW_PIN_UNVERIFIABLE$/,
+      `${status} ${JSON.stringify(body)}`);
+  }
+});
+
+function token(claims: Record<string, unknown>): string {
+  const encode = (value: unknown) => btoa(JSON.stringify(value)).replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", "");
+  return `${encode({ alg: "RS256" })}.${encode(claims)}.signature`;
+}
+
+Deno.test("runner refuses to post when its checkout differs from the GitHub-attested runner revision", () => {
+  assertRunnerRevision(token({ job_workflow_sha: sha }), sha);
+  assert.throws(() => assertRunnerRevision(token({ job_workflow_sha: "b".repeat(40) }), sha),
+    /COMPLETION_RUNNER_REVISION_MISMATCH/);
+  assert.throws(() => assertRunnerRevision(token({}), sha), /COMPLETION_RUNNER_REVISION_MISMATCH/);
+  assert.throws(() => assertRunnerRevision(token({ job_workflow_sha: sha }), "HEAD"), /COMPLETION_RUNNER_REVISION_MISMATCH/);
+  assert.throws(() => assertRunnerRevision("not-a-token", sha), /COMPLETION_/);
+});
