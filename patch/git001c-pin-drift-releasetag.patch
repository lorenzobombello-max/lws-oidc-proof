+name: Complete Website Project Preview Runner
+# GIT-001C pin-drift fix: reviewed monitor logic, called ONLY by the thin
+# workflow_run caller at a protected release tag (lws-preview-runner-YYYYMMDD-NN).
+# The completion endpoint accepts its OIDC token only when job_workflow_ref is
+# this file at the configured tag and job_workflow_sha equals the reviewed pin.
+# No customer artifacts are downloaded or executed here.
+on:
+  workflow_call:
+    inputs:
+      platform_ref:
+        description: "Reviewed release tag name; must equal the tag this runner is called at"
+        required: true
+        type: string
+      completion_endpoint:
+        required: true
+        type: string
+      completion_oidc_audience:
+        required: true
+        type: string
+permissions:
+  contents: read
+  id-token: write
+jobs:
+  complete:
+    runs-on: ubuntu-latest
+    timeout-minutes: 3
+    permissions:
+      contents: read
+      id-token: write
+    steps:
+      - name: Require a reviewed release tag name
+        shell: bash
+        env:
+          PLATFORM_REF: ${{ inputs.platform_ref }}
+        run: |
+          if [[ ! "$PLATFORM_REF" =~ ^lws-preview-runner-[0-9]{8}-[0-9]{2}$ ]]; then
+            echo "HARD STOP - platform_ref is not a reviewed release tag" >&2
+            exit 1
+          fi
+      - uses: actions/checkout@v4
+        with:
+          ref: refs/tags/${{ inputs.platform_ref }}
+          persist-credentials: false
+      - name: Record checked-out platform revision
+        shell: bash
+        run: echo "LWS_PLATFORM_HEAD=$(git rev-parse HEAD)" >> "$GITHUB_ENV"
+      - uses: denoland/setup-deno@v2
+        with:
+          deno-version: "2.9.5"
+      - name: Confirm provider outcome and finalize the existing lease
+        run: deno run --allow-env --allow-read --allow-net scripts/website-project-preview-complete.ts
+        env:
+          LWS_PREVIEW_COMPLETION_ENDPOINT: ${{ inputs.completion_endpoint }}
+          LWS_PREVIEW_COMPLETION_OIDC_AUDIENCE: ${{ inputs.completion_oidc_audience }}
